<group name="beenco_connect,">
  <rule id="110100" level="3">
    <decoded_as>beenco-connect-json</decoded_as>
    <description>Beenco Connect audit event</description>
  </rule>

  <rule id="110101" level="7">
    <if_sid>110100</if_sid>
    <field name="action">auth.login.fail</field>
    <description>Beenco Connect failed login</description>
  </rule>

  <rule id="110102" level="8">
    <if_sid>110100</if_sid>
    <field name="action">user.role.changed|retention.updated|feature_flag.updated</field>
    <description>Beenco Connect privileged configuration change</description>
  </rule>

  <rule id="110103" level="10">
    <if_sid>110100</if_sid>
    <field name="action">file.scan.quarantined</field>
    <description>Beenco Connect quarantined uploaded file</description>
  </rule>

  <rule id="110104" level="6">
    <if_sid>110100</if_sid>
    <field name="action">message.deleted|file.download.signed_url_issued|data_export.created</field>
    <description>Beenco Connect sensitive content action</description>
  </rule>

  <rule id="110105" level="5">
    <if_sid>110100</if_sid>
    <field name="action">call.created|call.token.requested</field>
    <description>Beenco Connect media room created</description>
  </rule>
</group>
