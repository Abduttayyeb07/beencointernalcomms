# Core
NODE_ENV=production
APP_BASE_URL=https://connect.beenco.local
PORTAL_PORT=4173
HOST=0.0.0.0
PORT=4173
SESSION_DAYS=14

# Auth (Keycloak/OIDC)
OIDC_ISSUER=https://auth.beenco.local/realms/beenco
OIDC_CLIENT_ID=beenco-connect-web
OIDC_CLIENT_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://connect.beenco.local/api/auth/google/callback
PORTAL_ADMIN_EMAIL=admin@beenco.local
PORTAL_ADMIN_PASSWORD=change-this-admin-password
PORTAL_ADMIN_NAME=Beenco Administrator

# Credentials used by the optional full Docker infrastructure stack.
POSTGRES_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password

# Database
DATABASE_URL=postgresql://beenco:replace-with-a-long-random-password@postgres:5432/beenco

# Redis
REDIS_URL=redis://redis:6379

# Search
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASS=change-me

# Object storage
S3_ENDPOINT=https://files.beenco.local
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=beenco-files
MAX_FILE_SIZE=15GB

# Antivirus
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Media
LIVEKIT_URL=wss://media.beenco.local
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me
TURN_URL=turn:media.beenco.local:3478
TURN_SECRET=change-me

# Mail
SMTP_HOST=mail.beenco.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Beenco Connect <connect@beenco.local>

# Audit / SIEM
AUDIT_LOG_PATH=/var/log/beenco/audit.json

# Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Amazon Bedrock LLM / AI Reports
ENABLE_BEDROCK_API=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=eu-central-1
AWS_BEDROCK_MODEL=qwen.qwen3-32b-v1:0
AWS_BEDROCK_ENDPOINT_URL=
LOCAL_FALLBACK_MODEL=qwen.qwen3-32b-v1:0

# Search APIs (Exa / Tavily)
EXA_API_KEY=
TAVILY_API_KEY=

# X/Twitter mentions monitor (Super Admin only)
TWITTERAPI_IO_KEY=
TWITTER_MENTIONS_RETENTION_DAYS=90
TWITTER_MENTIONS_MAX_PAGES=1
TWITTER_MENTIONS_ACCOUNT_INTERVAL_SECONDS=60
TWITTER_MENTIONS_RATE_LIMIT_COOLDOWN_MINUTES=30
TWITTER_MENTIONS_DAY_TIMEZONE=Asia/Karachi
TWITTER_MENTION_ACCOUNTS=PermaPod_xyz,NawaFinance,Ask_ORO,Valdora_finance,RukanPay,IndexLitro,nomyxio,BTCS_SA,fuzefinance,taurus_hq,ZIGScan,HiCryptoComics,DegenTer_Bot,Arkive_live,KOREIT_IO,BeencoLabs,decodeweb3AI,FracksProtocol,LendraOne,Pollin8_,MemesDotFun_,Toknex_xyz

